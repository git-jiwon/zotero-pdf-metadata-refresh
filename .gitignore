# Track only the reviewed project files listed below.
# Publish the checked source export produced by `npm run release:source`.
# New files remain untracked until they are reviewed and added here.
/*
!/.gitignore
!/.gitattributes
!/bootstrap.js
!/manifest.json
!/updates.json
!/package.json
!/package-lock.json
!/tsconfig.json
!/README.md
!/SECURITY.md
!/LICENSE
!/src/
/src/**
!/src/**/
!/src/**/*.ts
!/content/
/content/*
!/content/batch.xhtml
!/icons/
/icons/*
!/icons/icon.svg
!/icons/icon.png
!/icons/icon@2x.png
!/scripts/
/scripts/*
!/scripts/build.mjs
!/scripts/release-check.mjs
!/scripts/release-files.mjs
!/scripts/release-source.mjs
!/scripts/verify.mjs
!/scripts/snapshot.mjs
!/scripts/official-source.mjs
!/scripts/windows-pdf-images.ps1
!/scripts/windows-ocr-probe.ps1
!/test/
/test/*
!/test/release-security.test.mjs
!/test/release-ui.test.mjs
!/test/external-url.test.mjs
!/test/public-url.test.mjs
!/test/addon-shutdown.test.mjs
!/test/bootstrap-shutdown.test.mjs
!/test/i18n.test.mjs
!/test/selected-export.test.mjs
!/test/synthetic-policy.test.mjs
!/test/helpers/
/test/helpers/*
!/test/helpers/load-module.mjs
!/test/support/
/test/support/*
!/test/support/policy-harness.mjs
!/test/support/fake-window.mjs
!/test/support/window-entry.mjs
!/docs/
/docs/*
!/docs/README.ko.md
!/docs/USER-GUIDE.md
!/docs/USER-GUIDE.ko.md
!/docs/RELEASE-NOTES-1.0.0.md
!/docs/GITHUB-PUBLISHING.md
!/docs/PRIVACY.md
!/docs/images/
/docs/images/*
!/docs/images/demo-en-list.jpg
!/docs/images/demo-en-detail.jpg
!/docs/images/demo-en-settings.jpg
!/docs/images/demo-ko-list.jpg
!/docs/images/demo-ko-detail.jpg
!/docs/images/demo-ko-settings.jpg
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
!/.github/dependabot.yml

# Private credentials, caches, generated artifacts, and library extracts.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite*
**/*.db
**/*.pdf
**/*.xpi
**/*.log
**/node_modules/
**/.DS_Store
**/Thumbs.db
